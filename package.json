{
  "name": "agentpay-os",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate --schema packages/database/prisma/schema.prisma",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx packages/database/src/seed-cli.ts",
    "dev:api": "tsx apps/api/src/server.ts",
    "demo": "tsx scripts/demo.ts",
    "demo:payments": "tsx scripts/demo-payments.ts",
    "webhook:serve": "tsx apps/api/src/pey-webhook-server.ts",
    "webhook:configure": "tsx scripts/configure-pey-webhook.ts",
    "webhook:up": "tsx scripts/webhook-up.ts",
    "webhook:down": "tsx scripts/webhook-down.ts",
    "pey:configure-key": "tsx scripts/configure-pey-api-key.ts",
    "pey:configure-account": "tsx scripts/configure-pey-account.ts",
    "demo:pey": "tsx scripts/demo-pey-contract.ts",
    "pey:check-account": "tsx scripts/check-pey-account.ts",
    "pey:check-key": "tsx scripts/check-pey-key.ts",
    "demo:pey:recovery": "tsx scripts/demo-pey-contract.ts --lost-receipt",
    "agent:configure": "tsx scripts/configure-openai.ts",
    "demo:agent": "tsx scripts/demo-agent.ts",
    "web:dev": "tsx apps/api/src/web-server.ts",
    "web:up": "tsx scripts/web-up.ts",
    "web:contest": "tsx scripts/web-up.ts --contest",
    "demo:contest": "tsx scripts/demo-contest.ts"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "@types/node": "22.19.1",
    "prisma": "6.19.3",
    "tsx": "4.20.6",
    "@prisma/client": "6.19.3"
  },
  "type": "module"
}

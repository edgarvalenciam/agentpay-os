# Valores seguros. NO copiar credenciales a Git.
NODE_ENV=development
PAYMENT_PROVIDER=mock
ALLOW_REAL_PAYMENTS=false
PEY_BASE_URL=https://api.pey.mx
PEY_API_KEY=
PEY_WEBHOOK_SECRET=
OPENAI_API_KEY=
# Definir ruta absoluta: file:/ruta/al/proyecto/work/agentpay.db
DATABASE_URL=
# Tokens locales distintos, aleatorios, minimo 24 caracteres; no financieros
DEMO_BUYER_TOKEN=
DEMO_MERCHANT_TOKEN=
PORT=3001

# Solo simulador local G3: secretos nuevos y distintos, nunca llaves pey
MOCK_WEBHOOK_SECRET=
# Opcional: habilita controles de operador de test; no compartir con comprador
MOCK_CONTROL_TOKEN=
MOCK_SCENARIO=ACCEPT
